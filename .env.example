GHOSTPIXEL_APP_ENV=development
GHOSTPIXEL_DATA_ROOT=data/raw
GHOSTPIXEL_CHECKPOINT_PATH=checkpoints/stegonet.ckpt
GHOSTPIXEL_BACKBONE_NAME=mobilenet_v3_small
GHOSTPIXEL_PRETRAINED_BACKBONE=true
GHOSTPIXEL_FREEZE_BACKBONE=true
GHOSTPIXEL_IMAGE_SIZE=224
GHOSTPIXEL_NUM_CLASSES=4
GHOSTPIXEL_BATCH_SIZE=8
GHOSTPIXEL_NUM_WORKERS=2
GHOSTPIXEL_LEARNING_RATE=0.0003
GHOSTPIXEL_LOSS_NAME=cross_entropy
GHOSTPIXEL_LABEL_SMOOTHING=0.05
GHOSTPIXEL_FOCAL_GAMMA=2.0
GHOSTPIXEL_USE_CLASS_WEIGHTS=true
GHOSTPIXEL_CLASS_WEIGHT_POWER=1.0
GHOSTPIXEL_ACCUMULATE_GRAD_BATCHES=2
GHOSTPIXEL_MAX_EPOCHS=30
GHOSTPIXEL_TRAIN_BATCHES_PER_EPOCH=2000
GHOSTPIXEL_VAL_BATCHES_PER_EPOCH=200
GHOSTPIXEL_SCHEDULER_T_MAX=30
GHOSTPIXEL_STAGED_FINETUNING=false
GHOSTPIXEL_UNFREEZE_BACKBONE_EPOCH=6
GHOSTPIXEL_BACKBONE_FINETUNE_LEARNING_RATE=0.00005
GHOSTPIXEL_EARLY_STOPPING_PATIENCE=10
